---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "מקום שקט להיות בו שוב. חשיפה הדרגתית ומבוססת־הסכמה לצלילים, למי שחי עם פוסט־טראומה קרבית.",
} = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500&family=Heebo:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="px-6 sm:px-12 pt-8 pb-4">
      <nav class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/logo.png"
            alt="HearO"
            width="40"
            height="40"
            class="h-9 w-9 sm:h-10 sm:w-10"
          />
          <span class="font-display text-3xl sm:text-4xl tracking-tight leading-none" dir="ltr">
            Hear<span class="text-accent">O</span>
          </span>
        </a>
        <div class="flex items-center gap-6">
          <a href="/about" class="text-base text-text-mute hover:text-text transition-colors">
            אודות
          </a>
          <a href="/privacy" class="text-base text-text-mute hover:text-text transition-colors">
            פרטיות
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="px-6 sm:px-12 py-12 mt-16 border-t border-text-mute/20">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-start justify-between gap-6 text-sm text-text-mute">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <img src="/logo.png" alt="" width="24" height="24" class="h-6 w-6" />
            <p class="font-display text-base text-text" dir="ltr">HearO</p>
          </div>
          <p>מקום שקט להיות בו שוב.</p>
        </div>
        <div class="flex gap-6">
          <a href="/" class="hover:text-text transition-colors">בית</a>
          <a href="/about" class="hover:text-text transition-colors">אודות</a>
          <a href="/privacy" class="hover:text-text transition-colors">פרטיות</a>
        </div>
      </div>
    </footer>
  </body>
</html>
